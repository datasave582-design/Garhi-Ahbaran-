rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function admin(){return request.auth!=null&&request.auth.token.email=='admin@meragav.in';}
 function me(u){return request.auth!=null&&request.auth.uid==u;}
 function usr(){return get(/databases/$(d)/documents/users/$(request.auth.uid)).data;}
 function vs(k){return !exists(/databases/$(d)/documents/settings/vote)||get(/databases/$(d)/documents/settings/vote).data.get(k,true)!=false;}
 function rpk(){return /databases/$(d)/documents/likepick/$(request.auth.uid);}
 function rp(c){return /databases/$(d)/documents/reacts/$(c+'_'+request.auth.uid);}
 function pre(c,x){return (exists(rp(c))&&get(rp(c)).data.v==x)?1:0;}
 function post(c,x){return (existsAfter(rp(c))&&getAfter(rp(c)).data.v==x)?1:0;}
 match /users/{u}{allow read:if me(u)||admin();allow create:if me(u)&&request.resource.data.status=='pending';allow update:if admin()||(me(u)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo','profileStatus']));allow delete:if admin();}
 match /candidates/{c}{
  allow read:if resource.data.status=='approved'||me(c)||admin();
  allow create:if admin()||(me(c)&&request.resource.data.status=='pending');
  allow delete:if admin();
  allow update:if admin()||(request.auth!=null
   &&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','dislikes'])
   &&request.resource.data.get('likes',0)-resource.data.get('likes',0)==post(c,1)-pre(c,1)
   &&request.resource.data.get('dislikes',0)-resource.data.get('dislikes',0)==post(c,-1)-pre(c,-1));}
 match /likepick/{u}{
  allow read:if me(u)||admin();
  allow create:if me(u)&&existsAfter(/databases/$(d)/documents/reacts/$(request.resource.data.c+'_'+u))&&getAfter(/databases/$(d)/documents/reacts/$(request.resource.data.c+'_'+u)).data.v==1;
  allow delete:if me(u)&&!(existsAfter(/databases/$(d)/documents/reacts/$(resource.data.c+'_'+u))&&getAfter(/databases/$(d)/documents/reacts/$(resource.data.c+'_'+u)).data.v==1);}
 match /reacts/{r}{
  allow read:if admin()||(request.auth!=null&&resource.data.u==request.auth.uid);
  allow create,update:if request.auth!=null&&request.resource.data.u==request.auth.uid&&r==request.resource.data.c+'_'+request.auth.uid&&(
   (request.resource.data.v==-1&&(!existsAfter(rpk())||getAfter(rpk()).data.c!=request.resource.data.c))||
   (request.resource.data.v==1&&existsAfter(rpk())&&getAfter(rpk()).data.c==request.resource.data.c&&(!exists(rpk())||get(rpk()).data.c==request.resource.data.c)));
  allow delete:if admin()||(request.auth!=null&&resource.data.u==request.auth.uid&&(resource.data.v!=1||!existsAfter(rpk())||getAfter(rpk()).data.c!=resource.data.c));}
 match /claims/{i}{
  allow read:if resource.data.status=='approved'||me(resource.data.c)||admin();
  allow create:if me(request.resource.data.c)&&request.resource.data.status=='pending'&&get(/databases/$(d)/documents/candidates/$(request.auth.uid)).data.status=='approved';
  allow update,delete:if admin();}
 match /votes/{u}{allow read:if true;
  allow create:if me(u)&&usr().status=='approved'&&usr().role=='voter'&&request.resource.data.n==0&&vs('open');
  allow update:if admin()||(me(u)&&usr().status=='approved'&&usr().role=='voter'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['c','n','t'])&&request.resource.data.n==resource.data.get('n',0)+1&&request.resource.data.n<=3&&request.resource.data.c!=resource.data.c&&vs('open')&&vs('change');
  allow delete:if admin();}
 match /problems/{p}{allow read:if true;allow create:if request.auth!=null&&request.resource.data.uid==request.auth.uid;allow update:if admin();allow delete:if admin()||(request.auth!=null&&resource.data.uid==request.auth.uid);}
 match /plikes/{i}{allow read:if true;allow create:if request.auth!=null&&request.resource.data.u==request.auth.uid;allow delete:if request.auth!=null&&resource.data.u==request.auth.uid;}
 match /comments/{i}{allow read:if true;allow create:if request.auth!=null&&request.resource.data.uid==request.auth.uid;allow delete:if admin();}
 match /settings/{s}{allow read:if true;allow write:if admin();}
 match /devices/{i}{allow read:if request.auth!=null;allow create:if request.auth!=null&&request.resource.data.uid==request.auth.uid;allow update,delete:if admin();}
 match /chat/{i}{allow read:if true;allow create:if request.auth!=null&&request.resource.data.uid==request.auth.uid;allow delete:if admin();}
 match /profiles/{u}{allow read:if true;allow create,update:if me(u)||admin();allow delete:if me(u)||admin();}
 match /presence/{u}{allow read:if true;allow create,update:if me(u);allow delete:if me(u)||admin();}
 match /directChats/{r}{allow read:if request.auth!=null&&request.auth.uid in resource.data.members; allow create:if request.auth!=null&&request.auth.uid in request.resource.data.members; allow update:if request.auth!=null&&request.auth.uid in resource.data.members&&request.resource.data.members==resource.data.members;
   match /messages/{i}{allow read:if request.auth!=null&&request.auth.uid in get(/databases/$(d)/documents/directChats/$(r)).data.members;
     allow create:if request.auth!=null&&request.resource.data.from==request.auth.uid&&request.auth.uid in get(/databases/$(d)/documents/directChats/$(r)).data.members;
     allow delete:if admin()||request.auth.uid==resource.data.from;}}
}}
