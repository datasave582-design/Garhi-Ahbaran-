rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- सहायक नियम ----------
    // signedIn() = असली (Gmail/एडमिन) यूज़र. गेस्ट (anonymous) शामिल नहीं.
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function signedInAny() {
      return request.auth != null;
    }

    function isGuest() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@meragav.in';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // एडमिन ने जिसे "रोका" है (banned/{uid}) वह कुछ भेज/पोस्ट नहीं कर सकता
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    // settings/<id> में key false नहीं है (या doc ही नहीं है) तो ON माना जाएगा
    function settingOn(id, key) {
      return !exists(/databases/$(database)/documents/settings/$(id))
        || get(/databases/$(database)/documents/settings/$(id)).data.get(key, true) != false;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ---------- Like/Dislike की जाँच के सहायक नियम ----------
    function rpath(cid) {
      return /databases/$(database)/documents/reacts/$(cid + '_' + request.auth.uid);
    }
    function lpath() {
      return /databases/$(database)/documents/likepick/$(request.auth.uid);
    }
    // इस यूज़र की प्रतिक्रिया (1 / -1 / 0) लिखने से पहले और बाद में
    function rBefore(cid) {
      return exists(rpath(cid)) ? get(rpath(cid)).data.v : 0;
    }
    function rAfter(cid) {
      return existsAfter(rpath(cid)) ? getAfter(rpath(cid)).data.v : 0;
    }
    function cnt(v, t) {
      return v == t ? 1 : 0;
    }
    // नई गिनती = पुरानी + बदलाव (0 से नीचे नहीं)
    function stepOk(newN, oldN, d) {
      return newN == oldN + d || (oldN + d < 0 && newN == 0);
    }
    // एक यूज़र एक समय में सिर्फ एक प्रत्याशी को Like कर सकता है
    function likeOk(cid) {
      return existsAfter(lpath()) && getAfter(lpath()).data.c == cid
        && (!exists(lpath()) || get(lpath()).data.c == cid);
    }

    // ---------- खाते / प्रोफाइल ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['voter', 'candidate'];
      // यूज़र अपना status/role खुद नहीं बदल सकता
      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.status == resource.data.status
        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // जिन्हें एडमिन ने रोका है
    match /banned/{uid} {
      allow read: if isAdmin() || (signedInAny() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ---------- प्रत्याशी / वादे ----------
    match /candidates/{candidateId} {
      allow read: if true;
      allow create: if isAdmin() || (isOwner(candidateId) && request.resource.data.status == 'pending');
      // प्रत्याशी खुद को approved नहीं कर सकता (सिर्फ pending भेज सकता है)
      allow update: if isAdmin() || (isOwner(candidateId)
        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending'));
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.c == request.auth.uid
        && request.resource.data.status == 'pending' && notBanned();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.c == request.auth.uid);
    }

    // ---------- वोट ----------
    // पहला वोट n==0; बदलाव पर n सिर्फ +1, अधिकतम 3 बार; वोटिंग/बदलाव बंद हो तो रुकेगा;
    // वोट हटाना सिर्फ एडमिन (वरना हटाकर दोबारा वोट देने का रास्ता खुल जाता)
    match /votes/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid)
        && settingOn('vote', 'open')
        && myUser().get('status', '') == 'approved'
        && myUser().get('role', '') == 'voter'
        && request.resource.data.n == 0);
      allow update: if isAdmin() || (isOwner(uid)
        && settingOn('vote', 'open')
        && settingOn('vote', 'change')
        && resource.data.get('n', 0) < 3
        && request.resource.data.n == resource.data.get('n', 0) + 1
        && request.resource.data.c != resource.data.c);
      allow delete: if isAdmin();
    }

    // ---------- सोशल फीड ----------
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && notBanned()
        && (isAdmin() || !('pinned' in request.resource.data));
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.get('pinned', false) == resource.data.get('pinned', false));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /postLikes/{likeId} {
      allow read: if signedIn() && (resource == null || resource.data.u == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.u == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
    }

    match /postComments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && notBanned();
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && notBanned();
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- प्रत्याशी Like / Dislike ----------
    // सार्वजनिक सिर्फ कुल गिनती
    match /reactCounts/{candidateId} {
      allow read: if true;
      // गिनती तभी बदल सकती है जब उसी transaction में इस यूज़र की प्रतिक्रिया (reacts/<प्रत्याशी>_<uid>) भी बदली हो,
      // और बदलाव ठीक उसी के बराबर हो — इसलिए एक यूज़र की एक ही गिनती हो सकती है
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['likes', 'dislikes', 'updatedAt'])
        && request.resource.data.likes == cnt(rAfter(candidateId), 1)
        && request.resource.data.dislikes == cnt(rAfter(candidateId), -1));
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['likes', 'dislikes', 'updatedAt'])
        && stepOk(request.resource.data.likes, resource.data.likes, cnt(rAfter(candidateId), 1) - cnt(rBefore(candidateId), 1))
        && stepOk(request.resource.data.dislikes, resource.data.dislikes, cnt(rAfter(candidateId), -1) - cnt(rBefore(candidateId), -1)));
      allow delete: if isAdmin();
    }

    // निजी प्रतिक्रिया: doc-id = प्रत्याशी_uid (एक यूज़र की एक प्रत्याशी पर एक ही प्रतिक्रिया); दोबारा दबाने पर हट जाती है
    match /reacts/{reactionId} {
      allow get: if isAdmin() || (signedIn() && (resource == null || resource.data.u == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
      allow create: if signedIn() && request.resource.data.u == request.auth.uid
        && reactionId == request.resource.data.c + '_' + request.auth.uid
        && request.resource.data.v in [1, -1]
        && (request.resource.data.v != 1 || likeOk(request.resource.data.c));
      allow update: if isAdmin() || (signedIn() && request.resource.data.u == request.auth.uid
        && reactionId == request.resource.data.c + '_' + request.auth.uid
        && request.resource.data.v in [1, -1]
        && (request.resource.data.v != 1 || likeOk(request.resource.data.c)));
      allow delete: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
    }

    match /plikes/{likeId} {
      allow read: if signedIn() && (resource == null || resource.data.u == request.auth.uid);
      allow create: if signedIn() && request.resource.data.u == request.auth.uid;
      allow update: if signedIn() && request.resource.data.u == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
    }

    // likepick/<uid> = जिस प्रत्याशी को यूज़र ने Like किया है. हटाना तभी जब उसका Like भी हट चुका हो.
    match /likepick/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isOwner(uid)
        && (!existsAfter(/databases/$(database)/documents/reacts/$(resource.data.c + '_' + uid))
            || getAfter(/databases/$(database)/documents/reacts/$(resource.data.c + '_' + uid)).data.v != 1));
    }

    // ---------- चौपाल (गेस्ट भी कर सकता है) ----------
    match /chat/{messageId} {
      allow read: if true;
      allow create: if signedInAny() && request.resource.data.uid == request.auth.uid && notBanned()
        && settingOn('app', 'chatOpen')
        && request.resource.data.txt is string && request.resource.data.txt.size() > 0 && request.resource.data.txt.size() <= 1000
        && (!isGuest() || request.resource.data.role == 'guest');
      allow update: if isAdmin() || (signedInAny() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid
        && request.resource.data.get('role', '') == resource.data.get('role', ''));
      allow delete: if isAdmin() || (signedInAny() && resource.data.uid == request.auth.uid);
    }

    // ---------- निजी चैट (सिर्फ असली यूज़र) ----------
    match /directChats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        allow create: if signedIn() && notBanned()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        allow update: if signedIn() && request.auth.uid == resource.data.from && request.resource.data.from == resource.data.from;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.from);
      }
    }

    match /problems/{problemId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && notBanned();
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // बाल मंच: टीम स्कोरकार्ड और साप्ताहिक विजेता — सब पढ़ सकते हैं, सिर्फ एडमिन लिख सकता है
    match /kidsScores/{scoreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /kidsWeeks/{weekId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ग्राम सुविधा सर्वे: सार्वजनिक create, केवल एडमिन read/update/delete.
    match /villageSurveys/{surveyId} {
      allow create: if request.resource.data.mobileHash == surveyId
        && request.resource.data.name is string
        && request.resource.data.mobile is string;
      allow read, update, delete: if isAdmin();
    }

    // फोन-लॉक: असली यूज़र का doc-id = फोन ID; गेस्ट का guest_<फोन ID> (एक फोन = एक गेस्ट)
    match /devices/{deviceId} {
      allow read: if isAdmin() || (signedInAny() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid)
        || (isGuest() && deviceId.matches('guest_.*') && request.resource.data.uid == request.auth.uid && request.resource.data.guest == true);
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
