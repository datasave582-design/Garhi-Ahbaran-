rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'admin@meragav.in';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // User records contain private data such as voter-ID image.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Public-safe profile only: never store voter-ID here.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /candidates/{candidateId} {
      allow read: if true;
      allow create: if isAdmin() || (isOwner(candidateId) && request.resource.data.status == 'pending');
      allow update: if isAdmin() || isOwner(candidateId);
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.c == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.c == request.auth.uid);
    }

    // Votes are private records. Admin can read/edit/delete; voter can create/read/update own vote.
    match /votes/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin() || isOwner(uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /reacts/{reactionId} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.u == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
    }

    match /plikes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.u == request.auth.uid;
      allow update: if signedIn() && request.resource.data.u == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
    }

    match /chat/{messageId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /directChats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        allow update: if signedIn() && request.auth.uid == resource.data.from;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.from);
      }
    }

    match /problems/{problemId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
