rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // signedIn() = असली (Gmail) यूज़र. गेस्ट (anonymous) इसमें शामिल नहीं — गेस्ट सिर्फ चौपाल चैट कर सकता है.
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function signedInAny() {
      return request.auth != null;
    }

    function isGuest() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'admin@meragav.in';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // User records contain private data such as voter-ID image.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Public-safe profile only: never store voter-ID here.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /candidates/{candidateId} {
      allow read: if true;
      allow create: if isAdmin() || (isOwner(candidateId) && request.resource.data.status == 'pending');
      allow update: if isAdmin() || isOwner(candidateId);
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.c == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.c == request.auth.uid);
    }

    // Votes are private records. Admin can read/edit/delete; voter can create/read/update own vote.
    match /votes/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin() || isOwner(uid);
    }

    // Village social feed posts. Public to read; only owner/admin can edit/delete.
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Post Likes are private: a user can read/write only their own reaction.
    match /postLikes/{likeId} {
      allow read: if signedIn() && (resource == null || resource.data.u == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.u == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
    }

    // Post comments are public, while edits/deletes are limited to the author/admin.
    match /postComments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Public aggregate counts only; individual reactions remain private.
    match /reactCounts/{candidateId} {
      allow read: if true;
      // एक बार में सिर्फ ±1 बदलाव मान्य (कोई मनमानी संख्या नहीं डाल सकता); एडमिन recount कर सकता है
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['likes', 'dislikes', 'updatedAt'])
        && request.resource.data.likes is number
        && request.resource.data.dislikes is number
        && request.resource.data.likes >= 0 && request.resource.data.likes <= 1
        && request.resource.data.dislikes >= 0 && request.resource.data.dislikes <= 1);
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['likes', 'dislikes', 'updatedAt'])
        && request.resource.data.likes is number
        && request.resource.data.dislikes is number
        && request.resource.data.likes >= 0
        && request.resource.data.dislikes >= 0
        && request.resource.data.likes - resource.data.likes <= 1
        && resource.data.likes - request.resource.data.likes <= 1
        && request.resource.data.dislikes - resource.data.dislikes <= 1
        && resource.data.dislikes - request.resource.data.dislikes <= 1);
      allow delete: if isAdmin();
    }

    // Reactions are PRIVATE: a user can only read their own Like/Dislike.
    match /reacts/{reactionId} {
      allow get: if isAdmin() || (signedIn() && (resource == null || resource.data.u == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
      // doc-id = प्रत्याशी_uid → एक यूज़र की एक प्रत्याशी पर एक ही प्रतिक्रिया
      allow create: if signedIn() && request.resource.data.u == request.auth.uid
        && reactionId == request.resource.data.c + '_' + request.auth.uid
        && request.resource.data.v in [1, -1];
      // Dislike (-1) अंतिम है: उसके बाद बदलाव/हटाना नहीं (सिर्फ एडमिन)
      allow update: if isAdmin() || (signedIn() && request.resource.data.u == request.auth.uid
        && resource.data.v == 1
        && reactionId == request.resource.data.c + '_' + request.auth.uid
        && request.resource.data.v in [1, -1]);
      allow delete: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid && resource.data.v == 1);
    }

    // Problem Likes are PRIVATE too. Do not expose counts or names to other users.
    match /plikes/{likeId} {
      allow read: if signedIn() && (resource == null || resource.data.u == request.auth.uid);
      allow create: if signedIn() && request.resource.data.u == request.auth.uid;
      allow update: if signedIn() && request.resource.data.u == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.u == request.auth.uid);
    }

    // The selected candidate Like is private to the owner.
    match /likepick/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /chat/{messageId} {
      allow read: if true;
      allow create: if signedInAny() && request.resource.data.uid == request.auth.uid
        && request.resource.data.txt is string && request.resource.data.txt.size() > 0 && request.resource.data.txt.size() <= 1000
        && (!isGuest() || request.resource.data.role == 'guest');
      allow update: if isAdmin() || (signedInAny() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid
        && request.resource.data.get('role', '') == resource.data.get('role', ''));
      allow delete: if isAdmin() || (signedInAny() && resource.data.uid == request.auth.uid);
    }

    match /directChats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        allow update: if signedIn() && request.auth.uid == resource.data.from && request.resource.data.from == resource.data.from;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.from);
      }
    }

    match /problems/{problemId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ग्राम सुविधा सर्वे: सार्वजनिक create, केवल एडमिन read/update/delete.
    // mobileHash document ID एक ही मोबाइल के लिए deterministic ID है, इसलिए duplicate
    // create Firestore के स्तर पर already-exists से रुकता है।
    match /villageSurveys/{surveyId} {
      allow create: if request.resource.data.mobileHash == surveyId
        && request.resource.data.name is string
        && request.resource.data.mobile is string;
      allow read, update, delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if isAdmin() || (signedInAny() && (resource == null || resource.data.uid == request.auth.uid));
      // गेस्ट सिर्फ अपना guest_<फोन-ID> रिकॉर्ड बना सकता है (एक फोन = एक गेस्ट)
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid)
        || (isGuest() && deviceId.matches('guest_.*') && request.resource.data.uid == request.auth.uid && request.resource.data.guest == true);
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
